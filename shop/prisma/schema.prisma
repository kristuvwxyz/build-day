// Database schema for the shop.
// Production: PostgreSQL (Supabase, Neon, Railway, etc.).
// Vercel + Neon sets DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
// Quick local test: change provider to "sqlite", remove directUrl, and use DATABASE_URL="file:./dev.db".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled connection (used by the website)
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection (used to create/update tables)
}

// ---------- Login (NextAuth: Facebook / Google / Apple) ----------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())

  // MY ACCOUNT
  phone          String?
  birthday       DateTime?
  favoriteNotes  String    @default("") // comma-separated, e.g. "vanilla, oud"
  favoriteAccords String   @default("") // comma-separated, e.g. "woody, amber"
  favoriteBrands String    @default("")
  fragranticaUrl String?

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  wishlist      WishlistItem[]
  addresses     Address[]
  twoFactorCodes TwoFactorCode[]
  cancelRequests CancelRequest[]
  voucherRedemptions VoucherRedemption[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home") // "Home", "Office", ...
  name      String
  contact   String
  address   String
  barangay  String
  city      String
  region    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 2FA: one-time 6-digit codes sent by email after each login.
model TwoFactorCode {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   // the login session this code unlocks
  email        String
  codeHash     String
  attempts     Int      @default(0)
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  twoFactorVerifiedAt DateTime? // null until the email code is entered
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Shop ----------

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  imageUrl    String   @default("")
  price       Int      // in centavos (₱1,250.00 = 125000)
  type        String   // "PREORDER" | "ONHAND"
  stock       Int      @default(0) // used for ONHAND only
  eta         String?  // PREORDER only, e.g. "Arrives mid-December"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Perfume card (filled in by the shop; shown like a Fragrantica card)
  brand          String   @default("")
  perfumer       String   @default("")
  releaseYear    Int?
  gender         String   @default("") // "Women" | "Men" | "Unisex"
  concentration  String   @default("") // "EDP", "EDT", "Parfum", "Extrait"...
  sizeMl         Int?
  topNotes       String   @default("") // comma-separated
  heartNotes     String   @default("")
  baseNotes      String   @default("")
  accords        String   @default("") // "woody:100, amber:80, vanilla:65" (name:strength 0-100)
  longevity      String   @default("") // e.g. "Long lasting"
  sillage        String   @default("") // e.g. "Moderate"
  fragranticaUrl String?

  orderItems  OrderItem[]
  wishlistedBy WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// One checkout can create up to 2 orders that share a checkoutGroup:
//  - an ONHAND order (ships right away)
//  - a PREORDER order (ships when stock arrives)
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  checkoutGroup  String
  userId         String
  type           String   // "PREORDER" | "ONHAND"
  status         String   // see src/lib/orderStatus.ts

  // Shipping
  shippingMethod String   // "JNT" | "SAMEDAY"
  shipName       String
  shipContact    String
  shipAddress    String
  shipBarangay   String
  shipCity       String
  shipRegion     String   // "METRO_MANILA" | "LUZON" | "VISAYAS" | "MINDANAO"
  shipLat        Float?   // same-day only: exact drop-off point used for the Lalamove quote
  shipLng        Float?
  shipMapAddress String?  // address as Google Maps understood it
  trackingNumber String?

  // Money (centavos)
  subtotal       Int
  shippingFee    Int
  total          Int      // subtotal + shippingFee
  amountPaid     Int      @default(0)
  balanceDue     Int      @default(0) // remaining 50% for downpayment pre-orders

  notes          String?  // internal note from the shop
  buyerNote      String?  // NOTE from the cart
  packagingFee   Int      @default(0) // special packaging
  voucherCode    String?
  voucherDiscount Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  history        OrderStatusLog[]
  cancelRequests CancelRequest[]

  @@index([userId])
  @@index([checkoutGroup])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  name          String  // snapshot at time of purchase
  unitPrice     Int     // regular price
  discountPerUnit Int   @default(0) // e.g. ₱200 off for pre-order full payment
  quantity      Int
  paymentOption String  // "FULL" | "DOWNPAYMENT_50"
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// A payment can cover several orders (initial checkout) or one order (balance).
model Payment {
  id          String   @id @default(cuid())
  reference   String   @unique // sent to the gateway as our reference number
  kind        String   // "INITIAL" | "BALANCE"
  provider    String   // "MAYA" | "PAYPAL" | "BDO" | "MOCK"
  amount      Int      // centavos
  status      String   @default("PENDING") // "PENDING" | "PAID" | "FAILED"
  providerRef String?  // gateway's checkout/order id
  createdAt   DateTime @default(now())
  paidAt      DateTime?
  orders      Order[]
}

// Buyer asks to cancel; the shop approves or rejects it.
model CancelRequest {
  id         String    @id @default(cuid())
  orderId    String
  userId     String
  reason     String
  status     String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  shopReply  String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Voucher {
  id            String    @id @default(cuid())
  code          String    @unique // stored UPPERCASE
  description   String    @default("")
  type          String    // "PERCENT" | "FIXED"
  value         Int       // PERCENT: 10 = 10% · FIXED: centavos (10000 = ₱100)
  minSpend      Int       @default(0) // centavos, items subtotal
  maxDiscount   Int?      // centavos, cap for PERCENT vouchers
  usageLimit    Int?      // total uses allowed (null = unlimited)
  perUserLimit  Int       @default(1)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  redemptions   VoucherRedemption[]
}

// Recorded when the checkout payment succeeds.
model VoucherRedemption {
  id            String   @id @default(cuid())
  voucherId     String
  userId        String
  checkoutGroup String
  discount      Int
  createdAt     DateTime @default(now())
  voucher       Voucher  @relation(fields: [voucherId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voucherId, checkoutGroup])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  orderNumber String?
  subject   String
  message   String
  userId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
