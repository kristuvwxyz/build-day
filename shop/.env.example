# Copy this file to .env and fill in the values.

# ---------- Website ----------
# Your live domain (no trailing slash). Use http://localhost:3000 when testing locally.
NEXTAUTH_URL=http://localhost:3000
# Random secret. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Emails that can open /admin to update order statuses (comma-separated)
ADMIN_EMAILS=you@example.com

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------- Login: Facebook ----------
# developers.facebook.com → Create App → Facebook Login
# Valid OAuth Redirect URI: https://YOUR-DOMAIN/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- Login: Google ----------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Login: Apple ----------
# developer.apple.com (paid Apple Developer account) → Identifiers → Services ID
# Return URL: https://YOUR-DOMAIN/api/auth/callback/apple  (Apple does NOT allow localhost)
APPLE_ID=com.yourshop.web
# A JWT signed with your Apple .p8 key. Expires after max 6 months, so regenerate it before then.
APPLE_CLIENT_SECRET=

# ---------- Payment: Maya ----------
# Maya Business Manager → Developers → API keys
# Sandbox: https://pg-sandbox.paymaya.com   Live: https://pg.maya.ph
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=

# ---------- Payment: PayPal ----------
# developer.paypal.com → Apps & Credentials
# Sandbox: https://api-m.sandbox.paypal.com   Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- Payment: BDO Checkout ----------
# Needs code from BDO's merchant docs. See src/lib/payments/bdo.ts
BDO_MERCHANT_ID=
BDO_SECRET_KEY=
BDO_INTEGRATION_READY=false

# ---------- Same-day delivery: live Lalamove price ----------
# Also set SHOP_PICKUP (your pickup address + lat/lng) in src/lib/config.ts.
# Until all of these are set, same-day uses the flat fee in config.ts.
# Lalamove: partnerportal.lalamove.com → Developers → API keys
# Sandbox: https://rest.sandbox.lalamove.com   Live: https://rest.lalamove.com
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# Google Cloud console → enable "Geocoding API" → create an API key (restrict it to the Geocoding API)
GOOGLE_MAPS_API_KEY=

# ---------- Testing only ----------
# true = shows a "Test payment" option that always succeeds (ignored in production)
PAYMENT_MOCK=false
